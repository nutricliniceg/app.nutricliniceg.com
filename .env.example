# ==============================================================================
# NutriClinicEG - Environment Variables Example
# Duplicate this file as '.env' and fill in the values.
# All security-critical variables are marked below.
# ==============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000

# Security baseline (SEC-01, SEC-02)
# JWT_SECRET: Minimum 32 characters for HMAC SHA-256 integrity.
# Generate via: openssl rand -base64 32
JWT_SECRET=super-secret-key-at-least-32-chars-long-for-jwt

# ENCRYPTION_KEY: Minimum 32 characters (represents a 32-byte key)
# Generate via: openssl rand -hex 16 or use 32 secure chars
ENCRYPTION_KEY=encryption-key-must-be-at-least-32-chars

# Database: MySQL 8 (D-01)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=nutri_user
DATABASE_PASSWORD=nutri_password
DATABASE_NAME=nutricliniceg_db

# Email: Nodemailer over cPanel SMTP (§5.4)
SMTP_HOST=mail.nutricliniceg.com
SMTP_PORT=465
SMTP_USER=info@nutricliniceg.com
SMTP_PASSWORD=smtp_password_goes_here
SMTP_FROM=info@nutricliniceg.com

# Cron Job Protection Header Secret (SEC-13.2)
# Must match the secret header key sent by the hosting cron job runner.
CRON_SECRET=cron-secret-must-be-at-least-16-chars-long

# Optional Integration Endpoints (or empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
TURNSTILE_SECRET_KEY=

# File storage (P10, §6.5) — both optional for local dev
# STORAGE_DIR: outside-webroot upload directory (chmod 700, no execute)
# STORAGE_DIR=/home/user/storage/uploads
# FILE_URL_SECRET: min 16 chars, signs 15-min download URLs
# Generate via: openssl rand -base64 24
# FILE_URL_SECRET=

# AI provider layer (P12, §5.4) — optional for local dev
# AI_MOCK=true forces the deterministic offline MockAiClient (no network/keys).
# Tests always use the mock (NODE_ENV=test). Leave unset in production.
# AI_MOCK=

# Backups (P29 CRON-07/SEC-22) — all optional
# BACKUP_DIR: secure local dir (mode 0700) when no S3 env is set
# BACKUP_DIR=/home/user/secure-backups
# BACKUP_SCRATCH_DB: scratch database for weekly restore verification
# BACKUP_SCRATCH_DB=nutricliniceg_db_verify
# S3-compatible off-server upload (PF-11); absent = local-only + logged
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
